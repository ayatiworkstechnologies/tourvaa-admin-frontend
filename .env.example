# ─── Backend API ──────────────────────────────────────────────────────────────
# Used by browser-side code that talks to the API directly.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Server-only: target the Next.js /api/:path* rewrite proxies to (see next.config.ts).
# Required in production - the rewrite throws at build time if this is unset.
API_PROXY_TARGET=http://localhost:8000

# Public backend WebSocket origin, baked into the browser bundle at build time.
# Production: use your public wss:// backend origin. Required for production builds.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Canonical public website URL for metadata; set the real HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional interpreter override for the cross-repository API contract test.
# Otherwise the sibling backend venv is detected automatically.
# TOURVAA_TEST_PYTHON=/path/to/backend/venv/bin/python
