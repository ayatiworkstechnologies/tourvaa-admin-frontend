# ==============================================================================
# TOURVAA PRODUCTION FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# File: .env.production.example
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to .env.production on your frontend deployment server (or Vercel / Cloudflare).
# 2. Never commit production credentials to Git.
# ==============================================================================

# Server-only: target the Next.js /api/:path* rewrite proxies to (see next.config.ts).
# Required in production builds. Points to the internal or ingress API service.
API_PROXY_TARGET=https://api.tourvaa.com

# Public backend WebSocket origin, baked into the browser bundle at build time.
# Must use secure wss:// protocol in production.
NEXT_PUBLIC_WS_URL=wss://api.tourvaa.com

# Canonical public website URL for metadata, OpenGraph tags, and SEO sitemaps.
NEXT_PUBLIC_SITE_URL=https://tourvaa.com

# Production node environment
NODE_ENV=production
